<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- By default, disallow unencrypted cleartext HTTP traffic and trust only system CAs in production -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext HTTP only for local development servers and emulators -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.1.11</domain>
        <domain includeSubdomains="true">terriblenight.test</domain>
    </domain-config>

    <!-- User-installed certificates (e.g. debugging proxies) are only trusted in debuggable builds -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
