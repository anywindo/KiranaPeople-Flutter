<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug network configuration: allow local cleartext traffic and user CAs for debugging proxies -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext HTTP only for local development servers and emulators during debug -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.1.11</domain>
        <domain includeSubdomains="true">192.168.1.48</domain>
        <domain includeSubdomains="true">terriblenight.test</domain>
    </domain-config>

    <!-- Debug overrides for user CA certificates -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>

